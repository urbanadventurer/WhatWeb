##
#  wget-alexa-top-1m
#  - Download the NetAPI Top 1M domains in newline format
#    and write alexa-top-1m.txt, alexa-top-1000.txt and alexa-top-100.txt
#  - The Alexa Top 1M list this script used to fetch was retired by Alexa in
#    2022 and the old S3 address now serves a third-party placeholder; the
#    NetAPI Top 1M (https://netapi.com/top-1-mln-websites/, CC BY 4.0) has the
#    same rank,domain layout. The output file names are kept for the examples.
#  - Requires: wget
#  - Written by : Brendan Coles <bcoles@gmail.com> 2011-01-25
#  - Source replaced: 2026-10-20
##

# Check if wget is installed
WGET=`which wget 2>/dev/null`
if [ -z "$WGET" ]; then
	echo "[*] Fatal Error: wget is not installed - Aborting..."
	exit 1
fi

# Download
echo "[*] Downloading: https://netapi.com/netapi_top1mln.csv"
wget -O top-1m.csv "https://netapi.com/netapi_top1mln.csv"

# Check if top-1m.csv was downloaded
if [ -f "top-1m.csv" ]; then
	echo "[*] Formatting: top-1m.csv"
	# skip the header line (NetAPI_Rank,Domain), keep the domain column
	tail -n +2 top-1m.csv | cut -d, -f2- > alexa-top-1m.txt
else
	echo "[*] Fatal Error: top-1m.csv does not exist - Aborting..."
	exit 1
fi

# Check if alexa-top-1m.txt was created
if [ -f "alexa-top-1m.txt" ]; then
	echo "[*] Wrote: alexa-top-1m.txt"
	head -n 1000 alexa-top-1m.txt > alexa-top-1000.txt
	echo "[*] Wrote: alexa-top-1000.txt"
	head -n 100 alexa-top-1m.txt > alexa-top-100.txt
	echo "[*] Wrote: alexa-top-100.txt"
	head -n 10 alexa-top-1m.txt > alexa-top-10.txt
	echo "[*] Wrote: alexa-top-10.txt"
	echo "[*] Remove top-1m.csv"
	rm -f top-1m.csv
else
	echo "[*] Fatal Error: alexa-top-1m.txt does not exist - Aborting..."
	exit 1
fi

